<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RWORM</AssemblyName>
    <!-- Win32 exe icon (taskbar, explorer, alt-tab) -->
    <ApplicationIcon>Resources\Assets\rwormicon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Country flag PNGs rendered from the bundled SVGs; copied to output so
         ClientModel.FlagImagePath can resolve them from AppContext.BaseDirectory. -->
    <Content Include="Resources\Flags\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

</Project>