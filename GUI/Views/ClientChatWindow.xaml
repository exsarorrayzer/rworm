<Window x:Class="RWORM.GUI.Views.ClientChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Chat — v1" Height="560" Width="720"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Assets/chat.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleLabel" Text="Live Client Chat" FontSize="15" FontWeight="Bold"
                               Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1 Standard" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <Button Content="End Chat" Height="30" Width="85" Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right" Click="EndChat_Click"/>
            </DockPanel>
        </Border>

        <!-- Chat History -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                Margin="16,14,16,8" CornerRadius="8" Padding="14">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <!-- Input Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInput" Style="{StaticResource ModernTextBox}" Height="34"
                         Padding="10,6" KeyDown="TxtInput_KeyDown"
                         ToolTip="Type your message and press Enter or Send..."/>
                <Button Grid.Column="1" Content="Send" Width="85" Height="34" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}" Click="Send_Click"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Text="Connected to client session." Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
