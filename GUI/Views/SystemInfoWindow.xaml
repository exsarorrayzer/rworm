<Window x:Class="RWORM.GUI.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Information" Height="680" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#F5F5F5">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Width" Value="140"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Assets/sysinfo.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="System Details &amp; Hardware Profile" FontSize="15" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Refresh" Width="84" Height="30" HorizontalAlignment="Right"
                        Style="{StaticResource ModernButton}"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Power & Device Type Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Device &amp; Battery Status" FontWeight="Bold" FontSize="14" Foreground="#F87171"/>
                        </DockPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Device Type:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtDeviceType" Grid.Column="1" Style="{StaticResource ValueText}" FontWeight="Bold" Foreground="#C8C8C8"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Battery Level:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtBatteryLevel" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Power Source:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtPowerStatus" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Identity & Operating System Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Identity &amp; OS" FontWeight="Bold" FontSize="14" Foreground="#F87171" Margin="0,0,0,10"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Computer Name:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtHost" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="User / Domain:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtUser" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Operating System:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtOS" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="System Uptime:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtUptime" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware Specifications Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Hardware Specifications" FontWeight="Bold" FontSize="14" Foreground="#16A34A" Margin="0,0,0,10"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Processor (CPU):" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtCPU" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="BIOS Details:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtBIOS" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Total Physical RAM:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtRAM" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Screen Resolution:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtScreen" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Storage Disks Card -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Storage Disks" FontWeight="Bold" FontSize="14" Foreground="#F59E0B" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DrivesGrid" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="100"/>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="90"/>
                                <DataGridTextColumn Header="Total Size" Binding="{Binding Total}" Width="130"/>
                                <DataGridTextColumn Header="Free Space" Binding="{Binding Free}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Loading system information..." Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
