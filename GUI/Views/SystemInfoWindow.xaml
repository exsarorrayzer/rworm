<Window x:Class="RWORM.GUI.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detailed System Information" Height="640" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#18181b" Foreground="#f4f4f5">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f4f4f5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a1a1aa"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Width" Value="130"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="System Details &amp; Hardware Profile" FontSize="18" FontWeight="Bold" Foreground="#38bdf8" DockPanel.Dock="Left"/>
            <Button Content="Refresh" Width="80" Height="26" HorizontalAlignment="Right"
                    Background="#3f3f46" Foreground="#f4f4f5" BorderThickness="0"
                    Click="RefreshButton_Click"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Power & Device Type Card -->
                <Border Background="#27272a" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Device &amp; Battery Status" FontWeight="Bold" FontSize="14" Foreground="#a855f7" Margin="0,0,0,10"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Device Type:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtDeviceType" Grid.Column="1" Style="{StaticResource ValueText}" FontWeight="Bold"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Battery Level:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtBatteryLevel" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Power Source:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtPowerStatus" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Operating System & Identity Card -->
                <Border Background="#27272a" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Identity &amp; OS" FontWeight="Bold" FontSize="14" Foreground="#38bdf8" Margin="0,0,0,10"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Computer Name:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtHost" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="User / Domain:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtUser" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Operating System:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtOS" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="System Uptime:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtUptime" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hardware Specifications Card -->
                <Border Background="#27272a" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Hardware Specifications" FontWeight="Bold" FontSize="14" Foreground="#22c55e" Margin="0,0,0,10"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Processor (CPU):" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtCPU" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="BIOS Details:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtBIOS" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Total Physical RAM:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtRAM" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Screen Resolution:" Style="{StaticResource HeaderLabel}"/>
                            <TextBlock x:Name="TxtScreen" Grid.Column="1" Style="{StaticResource ValueText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Storage Disks Card -->
                <Border Background="#27272a" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Storage Disks" FontWeight="Bold" FontSize="14" Foreground="#eab308" Margin="0,0,10,10"/>
                        <DataGrid x:Name="DrivesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#18181b" RowBackground="#1f1f23" AlternatingRowBackground="#27272a"
                                  Foreground="#f4f4f5" BorderBrush="#3f3f46" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#3f3f46" HeadersVisibility="Column" Height="130">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="80"/>
                                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80"/>
                                <DataGridTextColumn Header="Total Size" Binding="{Binding Total}" Width="110"/>
                                <DataGridTextColumn Header="Free Space" Binding="{Binding Free}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StatusBar Grid.Row="2" Margin="0,8,0,0" Background="#18181b" Foreground="#a1a1aa">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Loading system information..." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
