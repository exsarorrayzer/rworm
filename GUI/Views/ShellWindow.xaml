<Window x:Class="RWORM.GUI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="580" Width="920"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="TerminalInput" TargetType="TextBox">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#E6EDF3"/>
            <Setter Property="FontFamily"       Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="CaretBrush"       Value="#58A6FF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- ── Title bar ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">

                <!-- Status dot + info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            DockPanel.Dock="Left">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#3FB950"
                             Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleLabel"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="12" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Shell label -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                    <TextBlock Text="powershell" FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="11" Foreground="#8B949E"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Terminal output ───────────────────────────────────────────────── -->
        <TextBox x:Name="OutputBox"
                 Grid.Row="1"
                 Background="#0D1117"
                 Foreground="#C9D1D9"
                 SelectionBrush="#264F78"
                 FontFamily="Cascadia Code, Consolas, Courier New"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Padding="14,10"
                 AcceptsReturn="True"/>

        <!-- ── Input bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#161B22"
                BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PS prompt -->
                <TextBlock Grid.Column="0"
                           Text="PS❯ "
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#3FB950"
                           VerticalAlignment="Center"/>

                <!-- Command input -->
                <TextBox x:Name="InputBox"
                         Grid.Column="1"
                         Style="{StaticResource TerminalInput}"
                         KeyDown="InputBox_KeyDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>
