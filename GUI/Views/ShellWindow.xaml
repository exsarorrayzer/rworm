<Window x:Class="RWORM.GUI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="580" Width="920"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundMainBrush}"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="TerminalInput" TargetType="TextBox">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#0F172A"/>
            <Setter Property="FontFamily"       Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="CaretBrush"       Value="#2563EB"/>
            <Setter Property="SelectionBrush"   Value="#93C5FD"/>
            <Setter Property="SelectionTextBrush" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{StaticResource BackgroundMainBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0" LastChildFill="False">

                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            DockPanel.Dock="Left">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#10B981"
                             Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleLabel"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontWeight="SemiBold"
                               FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="powershell" FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        
        <TextBox x:Name="OutputBox"
                 Grid.Row="1"
                 Background="{StaticResource BackgroundMainBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 SelectionBrush="#93C5FD"
                 SelectionTextBrush="#0F172A"
                 FontFamily="Cascadia Code, Consolas, Courier New"
                 FontSize="12.5"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Padding="16,12"
                 AcceptsReturn="True"/>

        
        <Border Grid.Row="2" Background="{StaticResource BackgroundSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                
                <TextBlock Grid.Column="0"
                           Text="PS❯ "
                           FontFamily="Cascadia Code, Consolas, Courier New"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#10B981"
                           VerticalAlignment="Center"/>

                
                <TextBox x:Name="InputBox"
                         Grid.Column="1"
                         Style="{StaticResource TerminalInput}"
                         KeyDown="InputBox_KeyDown"/>
            </Grid>
        </Border>
    </Grid>
</Window>
