<Window x:Class="RWORM.GUI.Views.BuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RWORM — Client Builder"
        Height="620" Width="860"
        MinHeight="540" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#E6EDF3">

    <Window.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#161B22"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#58A6FF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#161B22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="DarkCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CaretBrush" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark CheckBox -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Header / Tab Bar -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="🔨 RWORM BUILDER" FontSize="14" FontWeight="Bold" Foreground="#E6EDF3"
                               VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <RadioButton x:Name="TabSurveillance" Style="{StaticResource TabNavButton}" Content="SURVEILLANCE"
                                 GroupName="BuilderTabs" IsChecked="True" Click="Tab_Click" Tag="0"/>
                    <RadioButton x:Name="TabListener" Style="{StaticResource TabNavButton}" Content="LISTENER"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="1"/>
                    <RadioButton x:Name="TabAssembly" Style="{StaticResource TabNavButton}" Content="ASSEMBLY (DAHA EKLEMICEZ)"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="2"/>
                    <RadioButton x:Name="TabBuild" Style="{StaticResource TabNavButton}" Content="BUILD"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Contents -->
        <TabControl x:Name="TabPages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="20">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ── TAB 1: SURVEILLANCE ──────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Surveillance &amp; Evasion Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E6EDF3" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure persistence, process protection, sandboxing defense, and activity monitoring."
                                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,16"/>

                        <!-- Evasion & Security -->
                        <Border Style="{StaticResource DarkCard}">
                            <StackPanel>
                                <TextBlock Text="Defense &amp; Alerts" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Anti-Kill (Block Process Termination)"
                                          IsChecked="{Binding BuildAntiKill}"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Anti-Sandbox / Anti-VM (Halt in Virtual Environments)"
                                          IsChecked="{Binding BuildAntiSandbox}"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Discord Webhook Alert (Notify on client connection)"
                                          IsChecked="{Binding BuildDiscordAlert}" Margin="0,6,0,6"/>
                                <Grid Margin="24,0,0,4" IsEnabled="{Binding BuildDiscordAlert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Webhook URL:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="32"
                                             Text="{Binding BuildDiscordWebhook, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Persistence Settings -->
                        <Border Style="{StaticResource DarkCard}">
                            <StackPanel>
                                <TextBlock Text="Persistence Settings" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Startup Registry (HKCU\Software\Microsoft\Windows\CurrentVersion\Run)"
                                          IsChecked="{Binding BuildStartupRegistry}"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Scheduled Tasks (SCH TASKS — Auto-restart on user logon)"
                                          IsChecked="{Binding BuildSchTasks}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Installation / Startup Path:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" Width="320" Height="32"
                                             Text="{Binding BuildStartupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Surveillance / Keylogger / Loader -->
                        <Border Style="{StaticResource DarkCard}">
                            <StackPanel>
                                <TextBlock Text="Monitoring &amp; Tasks" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Enable Keylogger"
                                          IsChecked="{Binding BuildKeyloggerEnabled}"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,12" IsEnabled="{Binding BuildKeyloggerEnabled}">
                                    <RadioButton Content="Offline (log to file until retrieved)"
                                                 IsChecked="{Binding BuildKeyloggerOnline, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                                 Foreground="#8B949E" Margin="0,0,16,0"/>
                                    <RadioButton Content="Online (stream live)"
                                                 IsChecked="{Binding BuildKeyloggerOnline}"
                                                 Foreground="#8B949E"/>
                                </StackPanel>

                                <CheckBox Style="{StaticResource DarkCheckBox}" Content="Enable Loader Task on Connect"
                                          IsChecked="{Binding BuildTaskEnabled}" Margin="0,6,0,6"/>
                                <Grid Margin="24,0,0,0" IsEnabled="{Binding BuildTaskEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Payload URL:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="32"
                                             Text="{Binding BuildTaskUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 2: LISTENER ─────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Listener &amp; Connection Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E6EDF3" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure C2 connection parameters and dynamic host resolution."
                                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,16"/>

                        <!-- Primary Connection -->
                        <Border Style="{StaticResource DarkCard}">
                            <StackPanel>
                                <TextBlock Text="Primary C2 Server" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="IPs / C2 Host:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="34"
                                             Text="{Binding BuildHost, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Port:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="34"
                                             Text="{Binding BuildPort, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Encryption Key:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Height="34"
                                             Text="{Binding BuildEncryptionKey, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="False" ToolTip="Custom key rotation (daha eklemicez bunu)"/>
                                </Grid>
                                <TextBlock Text="ℹ️ (daha eklemicez bunu — default AES-256 standard channel active)"
                                           FontSize="11" Foreground="#6E7681" Margin="140,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Pastebin Host Resolution -->
                        <Border Style="{StaticResource DarkCard}">
                            <StackPanel>
                                <TextBlock Text="Dynamic Resolution (Pastebin Raw)" FontSize="14" FontWeight="SemiBold" Foreground="#58A6FF" Margin="0,0,0,12"/>
                                <TextBlock Text="Get IP / Port from Pastebin raw URL (Dynamic C2 fallback):" FontSize="12" Foreground="#8B949E" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Height="34"
                                         Text="{Binding BuildPastebinRaw, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Example: https://pastebin.com/raw/xxxxxx"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3: ASSEMBLY ─────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Assembly &amp; Metadata (DAHA EKLEMICEZ)" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E6EDF3" Margin="0,0,0,4"/>
                        <TextBlock Text="Clone binary metadata and custom icons to blend seamlessly into host operating systems."
                                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource DarkCard}" Opacity="0.6">
                            <StackPanel>
                                <Border Background="#21262D" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                                    <TextBlock Text="⚠️ DAHA EKLEMICEZ — Assembly spoofing and Icon injection will be enabled in the next update."
                                               Foreground="#D29922" FontWeight="SemiBold" FontSize="12"/>
                                </Border>

                                <Grid Margin="0,0,0,10" IsEnabled="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="File Title:" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="Chrome Updater"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Description:" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="Google Chrome Update Service"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Company:" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}" Text="Google LLC"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="False">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Icon File (.ico):" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="📁 Select Icon..." Background="#21262D" Foreground="#8B949E"
                                            BorderBrush="#30363D" BorderThickness="1" Height="32" HorizontalAlignment="Left" Padding="14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 4: BUILD ────────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Build Summary &amp; Compilation" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E6EDF3" Margin="0,0,0,4"/>
                        <TextBlock Text="Review active payload parameters and generate the self-contained executable (~11 MB)."
                                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,16"/>

                        <!-- Active Settings Card -->
                        <Border Style="{StaticResource DarkCard}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SETTINGS:" FontSize="14" FontWeight="SemiBold" Foreground="#3FB950" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Endpoint:" Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1" Foreground="#E6EDF3" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="BuildHost"/>
                                                <Binding Path="BuildPort"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pastebin Fallback:" Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildPastebinRaw, FallbackValue='(Not configured)'}" Foreground="#E6EDF3"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Encryption Key:" Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1" Text="AES-256 (daha eklemicez)" Foreground="#8B949E"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Binary Packaging:" Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1" Text="Self-Contained &amp; IL-Trimmed (Single File ~11 MB)" Foreground="#58A6FF" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keylogger Module:" Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildKeyloggerEnabled, StringFormat='Enabled: {0}'}" Foreground="#E6EDF3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Build Execution Card -->
                        <Border Style="{StaticResource DarkCard}" Background="#1F242C" BorderBrush="#3FB950">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ready to compile client payload." FontSize="14" FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                    <TextBlock Text="Compiled binary will be packaged as a standalone executable." FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#58A6FF" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- Red/Green Build Button as in drawing -->
                                <Button Grid.Column="1" Content="🚀 BUILD CLIENT"
                                        Command="{Binding BuildCommand}"
                                        Background="#DA3633" Foreground="White"
                                        FontSize="14" FontWeight="Bold"
                                        Height="48" Width="220" Cursor="Hand" Margin="16,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                                    BorderBrush="#F85149" BorderThickness="1.5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#B62324"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#3FB950" Margin="0,0,8,0"/>
                    <TextBlock Text="Ready — RWORM Modular Builder" FontSize="12" Foreground="#8B949E"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Payload: Windows x64 (~11 MB)" FontSize="12" Foreground="#8B949E"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
