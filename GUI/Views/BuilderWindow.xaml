<Window x:Class="RWORM.GUI.Views.BuilderWindow"
        xmlns:conv="clr-namespace:RWORM.GUI.Converters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RWORM — Client Builder"
        Height="620" Width="860"
        MinHeight="540" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Tab Button Style -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="LightCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Light TextBox -->
        <Style x:Key="LightTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light CheckBox -->
        <Style x:Key="LightCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header / Tab Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RWORM BUILDER" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <RadioButton x:Name="TabSurveillance" Style="{StaticResource TabNavButton}" Content="SURVEILLANCE"
                                 GroupName="BuilderTabs" IsChecked="True" Click="Tab_Click" Tag="0"/>
                    <RadioButton x:Name="TabListener" Style="{StaticResource TabNavButton}" Content="LISTENER"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="1"/>
                    <RadioButton x:Name="TabAssembly" Style="{StaticResource TabNavButton}" Content="ASSEMBLY &amp; CLONING"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="2"/>
                    <RadioButton x:Name="TabBuild" Style="{StaticResource TabNavButton}" Content="BUILD"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Contents -->
        <TabControl x:Name="TabPages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="20">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ── TAB 1: SURVEILLANCE ──────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Surveillance &amp; Evasion Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure persistence, process protection, sandboxing defense, and activity monitoring."
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Evasion & Security -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Defense &amp; Alerts" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Anti-Kill (Block Process Termination via Mutual Watchdog)"
                                          IsChecked="{Binding BuildAntiKill}"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Anti-Sandbox / Anti-VM (Halt in Virtual Environments)"
                                          IsChecked="{Binding BuildAntiSandbox}"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Discord Webhook Alert (Notify on client connection)"
                                          IsChecked="{Binding BuildDiscordAlert}" Margin="0,6,0,6"/>
                                <Grid Margin="24,0,0,4" IsEnabled="{Binding BuildDiscordAlert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Webhook URL:" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="34"
                                             Text="{Binding BuildDiscordWebhook, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Persistence Settings -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Persistence Settings" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Startup Registry (HKCU\Software\Microsoft\Windows\CurrentVersion\Run)"
                                          IsChecked="{Binding BuildStartupRegistry}"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Scheduled Tasks (SCH TASKS — Auto-restart on user logon)"
                                          IsChecked="{Binding BuildSchTasks}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Installation / Startup Path:" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Style="{StaticResource LightTextBox}" Width="320" Height="34"
                                             Text="{Binding BuildStartupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Surveillance / Keylogger / Loader -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Monitoring &amp; Tasks" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Enable Keylogger"
                                          IsChecked="{Binding BuildKeyloggerEnabled}"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,12" IsEnabled="{Binding BuildKeyloggerEnabled}">
                                    <RadioButton Content="Offline (log to file until retrieved)"
                                                 IsChecked="{Binding BuildKeyloggerOnline, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                                 Foreground="#475569" Margin="0,0,16,0"/>
                                    <RadioButton Content="Online (stream live)"
                                                 IsChecked="{Binding BuildKeyloggerOnline}"
                                                 Foreground="#475569"/>
                                </StackPanel>

                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Enable Loader Task on Connect"
                                          IsChecked="{Binding BuildTaskEnabled}" Margin="0,6,0,6"/>
                                <Grid Margin="24,0,0,0" IsEnabled="{Binding BuildTaskEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Payload URL:" FontSize="12" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="34"
                                             Text="{Binding BuildTaskUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 2: LISTENER ─────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Listener &amp; Connection Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure C2 connection parameters and dynamic host resolution."
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Primary Connection -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Primary C2 Server" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Host / IP:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildHost, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Port:" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildPort, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Encryption Key:" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildEncryptionKey, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="False" Background="#F1F5F9"/>
                                </Grid>
                                <TextBlock Text="Standard AES-256 encrypted tunnel active by default"
                                           FontSize="11" Foreground="#64748B" Margin="150,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Pastebin Host Resolution -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Dynamic Resolution (Pastebin Raw)" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,12"/>
                                <TextBlock Text="Get IP / Port from Pastebin raw URL (Dynamic C2 fallback):" FontSize="12" Foreground="#475569" Margin="0,0,0,8"/>
                                <TextBox Style="{StaticResource LightTextBox}" Height="36"
                                         Text="{Binding BuildPastebinRaw, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Cascadia Code, Consolas, Segoe UI"
                                         ToolTip="Example: https://pastebin.com/raw/xxxxxx"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3: ASSEMBLY ─────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Assembly &amp; Metadata (Notepad Spoofed)" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Clone binary metadata and custom icons to blend seamlessly into host operating systems."
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/shield.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ACTIVE — Watchdog spoofed as notepad.exe with authentic Microsoft Notepad assembly metadata &amp; icon."
                                                   Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="File Title:" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="Notepad" IsReadOnly="True" Background="#F8FAFC"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Description:" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="Notepad" IsReadOnly="True" Background="#F8FAFC"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Company:" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="Microsoft Corporation" IsReadOnly="True" Background="#F8FAFC"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Icon File:" Foreground="#475569" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="notepad.ico (Cloned from System32\notepad.exe RT_GROUP_ICON)" IsReadOnly="True" Background="#F8FAFC"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 4: BUILD ────────────────────────────────────────────── -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Build Summary &amp; Compilation" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#0F172A" Margin="0,0,0,4"/>
                        <TextBlock Text="Review active payload parameters and generate the self-contained executable (~11 MB)."
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Active Settings Card -->
                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE SETTINGS" FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Endpoint:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Foreground="#0F172A" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, Segoe UI">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="BuildHost"/>
                                                <Binding Path="BuildPort"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pastebin Fallback:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildPastebinRaw, FallbackValue='(Not configured)'}" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Binary Packaging:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Self-Contained &amp; IL-Trimmed (Single File ~11 MB)" Foreground="#2563EB" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Anti-Kill Protection:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildAntiKill, StringFormat='Active: {0}'}" Foreground="#0F172A" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Watchdog Process:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="notepad.exe (Stealth Watchdog)" Foreground="#10B981" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Assembly Spoofing:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="Notepad (Microsoft Corporation)" Foreground="#2563EB"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Discord Alert:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildDiscordAlert, StringFormat='Active: {0}'}" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keylogger Module:" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildKeyloggerEnabled, StringFormat='Enabled: {0}'}" Foreground="#0F172A"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Build Execution Card -->
                        <Border Style="{StaticResource LightCard}" Background="#F0FDF4" BorderBrush="#86EFAC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ready to compile client payload." FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Compiled binary will be packaged as a standalone executable." FontSize="12" Foreground="#475569" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding BuildCommand}"
                                        Background="#16A34A" Foreground="White"
                                        FontSize="14" FontWeight="Bold"
                                        Height="48" Width="220" Cursor="Hand" Margin="16,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BUILD CLIENT" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15803D"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="Ready — RWORM Modular Builder" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Payload: Windows x64 (~11 MB)" FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
