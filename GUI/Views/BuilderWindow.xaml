<Window x:Class="RWORM.GUI.Views.BuilderWindow"
        xmlns:conv="clr-namespace:RWORM.GUI.Converters"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RWORM — Client Builder"
        Height="620" Width="860"
        MinHeight="540" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="#1A1A1A" BorderThickness="1"
        Background="{StaticResource BackgroundSecondaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F1018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundMainBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="LightTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryHoverBrush}"/>
            <Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LightCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        
    </Window.Resources>

    <Grid x:Name="BuilderRoot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="LeechScale" ScaleX="0.05" ScaleY="0.05"/>
                <TranslateTransform x:Name="LeechTranslate" Y="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="LeechScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.05" To="1.0" Duration="0:0:0.65">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase Oscillations="2" Springiness="4" EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="LeechScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.05" To="1.0" Duration="0:0:0.65">
                            <DoubleAnimation.EasingFunction>
                                <ElasticEase Oscillations="2" Springiness="4" EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="BuilderRoot"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.0" To="1.0" Duration="0:0:0.25"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid Margin="12,0,8,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="#0C0C0C" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RWORM BUILDER" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>

                    <RadioButton x:Name="TabSurveillance" Style="{StaticResource TabNavButton}" Content="SURVEILLANCE"
                                 GroupName="BuilderTabs" IsChecked="True" Click="Tab_Click" Tag="0"/>
                    <RadioButton x:Name="TabListener" Style="{StaticResource TabNavButton}" Content="LISTENER"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="1"/>
                    <RadioButton x:Name="TabAssembly" Style="{StaticResource TabNavButton}" Content="ASSEMBLY &amp; CLONING"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="2"/>
                    <RadioButton x:Name="TabBuild" Style="{StaticResource TabNavButton}" Content="BUILD"
                                 GroupName="BuilderTabs" Click="Tab_Click" Tag="3"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBtnStyle}" Content="—" Click="MinimizeBtn_Click"/>
                    <Button Style="{StaticResource TitleBtnStyle}" Content="🗖" Click="MaximizeBtn_Click"/>
                    <Button Style="{StaticResource TitleCloseBtnStyle}" Content="✕" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="TabPages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="20">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Surveillance &amp; Evasion Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Defense &amp; Alerts" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Anti-Kill Protection"
                                          IsChecked="{Binding BuildAntiKill}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="Anti-Kill Protection Engine" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Runs embedded explorer.exe supervisor to prevent task kill and process termination by Task Manager, Process Hacker, and security software." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <CheckBox Style="{StaticResource LightCheckBox}" Content="AsyncRAT Obfuscator"
                                          IsChecked="{Binding BuildObfuscator}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="dnlib Renaming Obfuscator" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Renames classes, methods, parameters, and fields with randomized Unicode characters, effectively evading static signatures." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Discord Webhook Alert"
                                          IsChecked="{Binding BuildDiscordAlert}" Margin="0,6,0,6">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="Discord Connection Webhook" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Transmits notification alerts to your Discord channel whenever a client device comes online." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <Grid Margin="24,0,0,4" IsEnabled="{Binding BuildDiscordAlert}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Webhook URL:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="34"
                                             Text="{Binding BuildDiscordWebhook, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Persistence Settings" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Startup Registry Run Key"
                                          IsChecked="{Binding BuildStartupRegistry}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="HKCU Run Key Persistence" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Adds persistent startup autorun key under HKCU\Software\Microsoft\Windows\CurrentVersion\Run." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Scheduled Tasks (SCHTASKS)"
                                          IsChecked="{Binding BuildSchTasks}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="Windows Task Scheduler Persistence" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Registers a persistent Windows scheduled task that restarts the process on logon and user activity." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Installation / Startup Path:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Style="{StaticResource LightTextBox}" Width="320" Height="34"
                                             Text="{Binding BuildStartupPath, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Monitoring &amp; Tasks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Enable Keylogger Engine"
                                          IsChecked="{Binding BuildKeyloggerEnabled}">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="Stealth Keylogger Subsystem" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Records keystrokes, active window titles, and input timestamps with zero CPU lag." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <StackPanel Orientation="Horizontal" Margin="24,0,0,12" IsEnabled="{Binding BuildKeyloggerEnabled}">
                                    <RadioButton Content="Offline (buffer local)"
                                                 IsChecked="{Binding BuildKeyloggerOnline, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                                 Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                                    <RadioButton Content="Online (live stream)"
                                                 IsChecked="{Binding BuildKeyloggerOnline}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Download &amp; Execute Task on Connect"
                                          IsChecked="{Binding BuildTaskEnabled}" Margin="0,6,0,6">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="Payload Task Engine" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Fetches and executes an auxiliary executable or script immediately upon connection." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>

                                <Grid Margin="24,0,0,0" IsEnabled="{Binding BuildTaskEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Payload URL:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="34"
                                             Text="{Binding BuildTaskUrl, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Listener &amp; Connection Settings" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure C2 connection parameters and dynamic host resolution."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <TextBlock Text="Primary C2 Server" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Host / IP:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildHost, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="C2 Port:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildPort, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Encryption Key:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildEncryptionKey, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             FontWeight="SemiBold"
                                             FontSize="13"/>
                                    <Button Grid.Column="2" Content="Generate Key" Command="{Binding GenerateKeyCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,0" Height="36" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="Standard AES-256 encrypted tunnel active by default"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="150,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Dynamic Resolution (Pastebin Raw)"
                                          IsChecked="{Binding BuildPastebinEnabled}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="Dynamic Pastebin C2 Fallback" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Allows fetching the real-time C2 address and port dynamically from a Pastebin raw link." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <Grid IsEnabled="{Binding BuildPastebinEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildPastebinRaw, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Cascadia Code, Consolas, Segoe UI"
                                             ToolTip="Example: https://pastebin.com/raw/xxxxxx"/>
                                    <Button Grid.Column="1" Content="Test Raw URL" Command="{Binding TestPastebinCommand}"
                                            Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0"
                                            Padding="14,0" Height="36" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Client Assembly &amp; Icon" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource LightCheckBox}" Content="Custom Application Icon (.ico)"
                                          IsChecked="{Binding BuildIconEnabled}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,10">
                                    <CheckBox.ToolTip>
                                        <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="PE Application Icon" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                <TextBlock Text="Embeds a custom icon resource into the final compiled client binary." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <Grid IsEnabled="{Binding BuildIconEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource LightTextBox}" Height="36"
                                             Text="{Binding BuildIconPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Optional icon path (.ico)"/>
                                    <Button Grid.Column="1" Content="Select .ico File" Command="{Binding SelectIconCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,0" Height="36" Margin="10,0,0,0" FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <CheckBox Style="{StaticResource LightCheckBox}" Content="Custom Assembly Spoofing"
                                              IsChecked="{Binding BuildAssemblyEnabled}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                                        <CheckBox.ToolTip>
                                            <ToolTip Background="#0A0A0A" BorderBrush="#252525" BorderThickness="1" Padding="12">
                                                <StackPanel MaxWidth="320">
                                                    <TextBlock Text="Authenticode Metadata Cloning" FontWeight="Bold" Foreground="#5865F2" FontSize="12"/>
                                                    <TextBlock Text="Spoofs Company, Copyright, Product, Description, and File Version headers to mimic legitimate Windows software." Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                    <Button DockPanel.Dock="Right" Content="Clone Assembly from File" Command="{Binding CloneAssemblyCommand}"
                                            Background="{StaticResource SuccessBrush}" Foreground="White" BorderThickness="0"
                                            Padding="14,0" Height="32" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DockPanel>

                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="File Title:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Description:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Company:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyCompany, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Product:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyProduct, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Copyright:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyCopyright, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10" IsEnabled="{Binding BuildAssemblyEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Version:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource LightTextBox}" Text="{Binding BuildAssemblyVersion, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="Last Build Config" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource LightCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Endpoint:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontFamily="Cascadia Code, Consolas, Segoe UI">
                                        <TextBlock.Text>
                                             <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="BuildHost"/>
                                                <Binding Path="BuildPort"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pastebin Fallback:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildPastebinRaw, FallbackValue='(Not configured)'}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Binary Packaging:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Self-Contained &amp; IL-Trimmed (Single File ~11 MB)" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Anti-Kill Protection:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildAntiKill, StringFormat='Active: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="AsyncRAT Obfuscator:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildObfuscator, StringFormat='Active: {0}'}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Assembly Spoofing:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildAssemblyEnabled, StringFormat='Enabled: {0}'}" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Custom Icon:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildIconEnabled, StringFormat='Enabled: {0}'}" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Discord Alert:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildDiscordAlert, StringFormat='Active: {0}'}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keylogger Module:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BuildKeyloggerEnabled, StringFormat='Enabled: {0}'}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource LightCard}" Background="#080808" BorderBrush="#1C1C1C">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ready to compile client payload." FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Compiled binary will be packaged as a standalone executable." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding BuildCommand}"
                                        Background="{StaticResource SuccessBrush}" Foreground="White"
                                        FontSize="14" FontWeight="Bold"
                                        Height="48" Width="220" Cursor="Hand" Margin="16,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BUILD CLIENT" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#059669"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Payload: Windows x64 (~11 MB)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
