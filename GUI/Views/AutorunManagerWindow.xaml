<Window x:Class="RWORM.GUI.Views.AutorunManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        Title="Startup &amp; Autorun Manager">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{StaticResource BackgroundMainBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="🗑 Remove Entry" Click="Delete_Click" Style="{StaticResource ModernButton}" Height="30" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource ModernButton}" Height="30" Padding="12,4"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="200" Height="30" Margin="0,0,8,0"
                         Style="{StaticResource ModernTextBox}" TextChanged="SearchBox_TextChanged"
                         ToolTip="Search startup entries..."/>
            </DockPanel>
        </Border>

        
        <DataGrid x:Name="StartupGrid" Grid.Row="1"
                  Style="{StaticResource ModernDataGrid}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="150"/>
                <DataGridTextColumn Header="Entry Name" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Command / Target" Binding="{Binding Command}" Width="*"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        
        <Border Grid.Row="2" Background="{StaticResource BackgroundMainBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
