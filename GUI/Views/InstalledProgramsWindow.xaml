<Window x:Class="RWORM.GUI.Views.InstalledProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed Programs" Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#18181b" Foreground="#f4f4f5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Height="28" Padding="6,4"
                     Background="#27272a" Foreground="#f4f4f5" BorderBrush="#3f3f46"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter installed applications by name, publisher, or version"/>
            <Button Grid.Column="1" Content="Refresh" Width="80" Height="28" Margin="8,0,0,0"
                    Background="#3f3f46" Foreground="#f4f4f5" BorderThickness="0"
                    Click="RefreshButton_Click"/>
        </Grid>

        <DataGrid x:Name="ProgramsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#27272a" RowBackground="#1f1f23" AlternatingRowBackground="#27272a"
                  Foreground="#f4f4f5" BorderBrush="#3f3f46" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3f3f46" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Display Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2" Margin="0,8,0,0" Background="#18181b" Foreground="#a1a1aa">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Loading installed programs..." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
