<Window x:Class="RWORM.GUI.Views.InstalledProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installed Programs" Height="580" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header / Toolbar -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Assets/programs.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Installed Programs" FontSize="15" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="240" Height="30" Margin="0,0,10,0"
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Filter applications by name, publisher, or version..."/>
                    <Button Content="Refresh" Width="80" Height="30"
                            Style="{StaticResource ModernButton}"
                            Click="RefreshButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Programs Grid -->
        <DataGrid x:Name="ProgramsGrid" Grid.Row="1"
                  Style="{StaticResource ModernDataGrid}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Display Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" />
                <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Loading installed programs..." Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
