<Window x:Class="RWORM.GUI.Views.ServiceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#F5F5F5"
        Title="Service Manager">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="▶ Start" Click="Start_Click" Style="{StaticResource ModernButton}" Height="30" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="⏹ Stop" Click="Stop_Click" Style="{StaticResource ModernButton}" Height="30" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="🔄 Restart" Click="Restart_Click" Style="{StaticResource ModernButton}" Height="30" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource ModernButton}" Height="30" Padding="12,4"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="200" Height="30" Margin="0,0,8,0"
                         Style="{StaticResource ModernTextBox}" TextChanged="SearchBox_TextChanged"
                         ToolTip="Search service name or display name..."/>
            </DockPanel>
        </Border>

        <!-- Services DataGrid -->
        <DataGrid x:Name="ServicesGrid" Grid.Row="1"
                  Style="{StaticResource ModernDataGrid}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
