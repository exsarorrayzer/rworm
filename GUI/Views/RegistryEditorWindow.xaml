<Window x:Class="RWORM.GUI.Views.RegistryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="680" Width="1100"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        Title="Registry Editor">

    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground"   Value="#0F172A"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Padding"      Value="2,3"/>
        </Style>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background"     Value="#FFFFFF"/>
            <Setter Property="Foreground"     Value="#0F172A"/>
            <Setter Property="BorderBrush"    Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="10,5"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✎ Edit Value"  Click="EditValue_Click"  Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="＋ New Value"  Click="NewValue_Click"   Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="🗑 Delete"      Click="DeleteValue_Click" Style="{StaticResource Btn}" Margin="0,0,6,0" Foreground="#F85149"/>
                    <Button Content="⟳ Refresh"     Click="Refresh_Click"    Style="{StaticResource Btn}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main split: Tree | Values -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Registry key tree -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <TreeView x:Name="KeyTree"
                          Background="#FFFFFF"
                          Foreground="#0F172A"
                          BorderThickness="0"
                          SelectedItemChanged="KeyTree_SelectedItemChanged">
                    <!-- Populated dynamically -->
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#F1F5F9"/>

            <!-- Values grid -->
            <DataGrid x:Name="ValuesGrid"
                      Grid.Column="2"
                      Background="#FFFFFF"
                      Foreground="#0F172A"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#21262D"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      FontSize="12"
                      FontFamily="Segoe UI"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"  Binding="{Binding Name}"  Width="180"/>
                    <DataGridTextColumn Header="Type"  Binding="{Binding Kind}"  Width="90"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Path bar / status -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock Text="Path:" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="PathLabel" Foreground="#0F172A" FontFamily="Cascadia Code, Consolas"
                           FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLabel" DockPanel.Dock="Right" Foreground="#64748B"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
