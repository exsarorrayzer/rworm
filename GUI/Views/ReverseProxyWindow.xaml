<Window x:Class="RWORM.GUI.Views.ReverseProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reverse SOCKS / Port Proxy" Height="480" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Assets/proxy.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleLabel" Text="Reverse Proxy" FontSize="15" FontWeight="Bold"
                               Foreground="#F5F5F5" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Configuration Bar -->
        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Local Port:" FontSize="12.5" FontWeight="SemiBold" Foreground="#8A8A8A"
                           VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="0"/>
                <TextBox x:Name="TxtLocalPort" Style="{StaticResource ModernTextBox}" Height="30" Text="1080"
                         Grid.Column="1" Margin="0,0,16,0" ToolTip="Local listening port on operator machine"/>

                <TextBlock Text="Forward To:" FontSize="12.5" FontWeight="SemiBold" Foreground="#8A8A8A"
                           VerticalAlignment="Center" Margin="0,0,8,0" Grid.Column="2"/>
                <TextBox x:Name="TxtTarget" Style="{StaticResource ModernTextBox}" Height="30" Text="127.0.0.1:80"
                         Grid.Column="3" Margin="0,0,16,0" ToolTip="Target address reachable by the remote client (e.g. 127.0.0.1:80 or 192.168.1.1:445)"/>

                <Button x:Name="BtnToggle" Content="▶ Start Proxy" Width="110" Height="30"
                        Style="{StaticResource PrimaryButton}" Grid.Column="4"
                        Click="Toggle_Click"/>
            </Grid>
        </Border>

        <!-- Activity Log -->
        <Border Grid.Row="2" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="1"
                Margin="16" CornerRadius="8" Padding="12">
            <TextBox x:Name="TxtLogs" BorderThickness="0" Background="Transparent" Foreground="#C8C8C8"
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Text="Proxy ready." Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
