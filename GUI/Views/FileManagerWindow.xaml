<Window x:Class="RWORM.GUI.Views.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="640" Width="1000"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#141414" Foreground="#F5F5F5"
        Title="File Manager">

    <Window.Resources>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#262626"/>
                                <Setter Property="BorderBrush" Value="#4A4A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader" x:Key="HeaderStyle">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#2E2E2E"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="CellStyle">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬆ Upload" Click="Upload_Click"
                            Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="⬇ Download" Click="Download_Click"
                            Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="📁 New Folder" Click="NewFolder_Click"
                            Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="🗑 Delete" Click="Delete_Click"
                            Style="{StaticResource Btn}" Foreground="#EF4444"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Path bar -->
        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" Style="{StaticResource Btn}"
                        Click="Back_Click" Width="36" Height="30" Padding="0" Margin="0,0,8,0"/>
                <TextBox x:Name="PathBox"
                         Background="#1A1A1A" Foreground="#F5F5F5"
                         CaretBrush="#F5F5F5"
                         BorderBrush="#3A3A3A" BorderThickness="1"
                         Padding="10,0" FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12" KeyDown="PathBox_KeyDown" Height="30" VerticalContentAlignment="Center">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" VerticalScrollBarVisibility="Disabled"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- File list -->
        <DataGrid x:Name="FileGrid"
                  Grid.Row="2"
                  Background="#1A1A1A"
                  Foreground="#F5F5F5"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2E2E2E"
                  RowBackground="#1A1A1A"
                  AlternatingRowBackground="#141414"
                  BorderThickness="0"
                  FontSize="12.5"
                  FontFamily="Segoe UI"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  CellStyle="{StaticResource CellStyle}"
                  MouseDoubleClick="FileGrid_DoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Foreground" Value="#F5F5F5"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#DC2626"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Type" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="*"/>
                <DataGridTextColumn Header="Size"     Binding="{Binding SizeStr}"  Width="100"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <Border Grid.Row="3" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Margin="16,0"
                       Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
