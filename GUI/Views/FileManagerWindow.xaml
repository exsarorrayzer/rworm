<Window x:Class="RWORM.GUI.Views.FileManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="640" Width="1000"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        Title="File Manager">

    <Window.Resources>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⬆ Upload" Click="Upload_Click"
                            Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="⬇ Download" Click="Download_Click"
                            Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="📁 New Folder" Click="NewFolder_Click"
                            Style="{StaticResource Btn}" Margin="0,0,6,0"/>
                    <Button Content="🗑 Delete" Click="Delete_Click"
                            Style="{StaticResource Btn}" Foreground="#F85149"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Path bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <Button DockPanel.Dock="Left" Content="←" Style="{StaticResource Btn}"
                        Click="Back_Click" Width="32" Margin="0,0,8,0"/>
                <TextBox x:Name="PathBox"
                         Background="#F1F5F9" Foreground="#E6EDF3"
                         BorderBrush="#30363D" BorderThickness="1"
                         Padding="8,4" FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12" KeyDown="PathBox_KeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- File list -->
        <DataGrid x:Name="FileGrid"
                  Grid.Row="2"
                  Background="#FFFFFF"
                  Foreground="#E6EDF3"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#21262D"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#12161B"
                  BorderThickness="0"
                  FontSize="12"
                  FontFamily="Segoe UI"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  MouseDoubleClick="FileGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Type" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="*"/>
                <DataGridTextColumn Header="Size"     Binding="{Binding SizeStr}"  Width="90"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Margin="16,0"
                       Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
