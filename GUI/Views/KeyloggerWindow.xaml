<Window x:Class="RWORM.GUI.Views.KeyloggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        Title="Keylogger">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OnlineBtn"  Content="▶ Online"   Click="Online_Click"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            Padding="12,6" Cursor="Hand" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="OfflineBtn" Content="📁 Offline Dump" Click="Offline_Click"
                            Background="#FFFFFF" Foreground="#0F172A" BorderThickness="1" BorderBrush="#CBD5E1"
                            Padding="12,6" Cursor="Hand" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="⏹ Stop"      Click="Stop_Click"
                            Background="#EF4444" Foreground="White" BorderThickness="0"
                            Padding="12,6" Cursor="Hand" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="💾 Save"      Click="Save_Click"
                            Background="#10B981" Foreground="White" BorderThickness="0"
                            Padding="12,6" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log output -->
        <TextBox x:Name="LogBox"
                 Grid.Row="1"
                 Background="#FFFFFF"
                 Foreground="#0F172A"
                 SelectionBrush="#93C5FD"
                 SelectionTextBrush="#0F172A"
                 CaretBrush="#0F172A"
                 FontFamily="Cascadia Code, Consolas, Courier New"
                 FontSize="12.5"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Padding="16,12"
                 AcceptsReturn="True"/>

        <!-- Status -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLabel" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" Text="Idle"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
