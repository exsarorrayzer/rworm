<Window x:Class="RWORM.GUI.Views.KeyloggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#E6EDF3"
        Title="Keylogger">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OnlineBtn"  Content="▶ Online"   Click="Online_Click"
                            Background="#1F6FEB" Foreground="White" BorderThickness="0"
                            Padding="10,6" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="OfflineBtn" Content="📁 Offline Dump" Click="Offline_Click"
                            Background="#21262D" Foreground="#E6EDF3" BorderThickness="1" BorderBrush="#30363D"
                            Padding="10,6" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="⏹ Stop"      Click="Stop_Click"
                            Background="#DA3633" Foreground="White" BorderThickness="0"
                            Padding="10,6" Cursor="Hand" Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="💾 Save"      Click="Save_Click"
                            Background="#238636" Foreground="White" BorderThickness="0"
                            Padding="10,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log output -->
        <TextBox x:Name="LogBox"
                 Grid.Row="1"
                 Background="#0D1117"
                 Foreground="#C9D1D9"
                 FontFamily="Cascadia Code, Consolas, Courier New"
                 FontSize="12"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0"
                 Padding="14,10"
                 AcceptsReturn="True"/>

        <!-- Status -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3FB950" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusLabel" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Text="Idle"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
