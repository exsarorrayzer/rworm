<Window x:Class="RWORM.GUI.Views.WebcamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="760"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#FFFFFF"
        Title="Webcam Stream">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" Text="Webcam" FontSize="14" FontWeight="SemiBold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="Device:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DeviceCombo" Width="200" Height="28" Margin="0,0,12,0"
                              SelectionChanged="DeviceCombo_SelectionChanged"/>

                    <Button x:Name="PauseBtn" Content="⏸ Pause" Click="Pause_Click"
                            Style="{StaticResource SecondaryButton}" Height="30" Padding="12,4" Margin="0,0,8,0"/>
                    <Button Content="📸 Save Snapshot" Click="Snapshot_Click"
                            Style="{StaticResource SecondaryButton}" Height="30" Padding="12,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Frames: " Foreground="#94A3B8" FontSize="12"/>
                    <TextBlock x:Name="FrameCountLabel" Text="0" Foreground="#10B981" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video View -->
        <Border Grid.Row="1" Background="#0B0F19" Margin="10" CornerRadius="8" ClipToBounds="True">
            <Image x:Name="CamView" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
