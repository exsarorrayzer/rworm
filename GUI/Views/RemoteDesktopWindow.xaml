<Window x:Class="RWORM.GUI.Views.RemoteDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="620" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#E6EDF3"
        Title="Remote Desktop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,0">
                <TextBlock x:Name="TitleLabel" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FPS:" Foreground="#8B949E" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="FpsSlider" Minimum="1" Maximum="20" Value="5" Width="80"
                            VerticalAlignment="Center" Margin="0,0,12,0"
                            ValueChanged="FpsSlider_Changed"/>
                    <TextBlock x:Name="FpsLabel" Foreground="#E6EDF3" FontSize="11"
                               VerticalAlignment="Center" Width="24" Margin="0,0,12,0"/>
                    <Button Content="⏸ Pause" x:Name="PauseBtn" Click="Pause_Click"
                            Background="#21262D" Foreground="#E6EDF3"
                            BorderBrush="#30363D" BorderThickness="1"
                            Padding="8,4" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Screen view -->
        <Border Grid.Row="1" Background="Black">
            <Image x:Name="ScreenView"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="LowQuality"/>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#3FB950"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusLabel" Foreground="#8B949E" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FpsActual" DockPanel.Dock="Right" Foreground="#8B949E"
                           FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
