<Window x:Class="RWORM.GUI.Views.RemoteDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        Title="Remote Desktop — Interactive Screen Viewer">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Header Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="AsyncRAT Screen Engine" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Monitor Selector -->
                    <TextBlock Text="Display:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="MonitorSelector" Width="140" Height="28" Margin="0,0,12,0"
                              SelectionChanged="MonitorSelector_SelectionChanged"
                              VerticalContentAlignment="Center" FontSize="11.5"/>

                    <!-- FPS Slider -->
                    <TextBlock Text="FPS:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="FpsLabel" Text="8" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Width="24" Margin="0,0,8,0"/>
                    <Slider x:Name="FpsSlider" Minimum="1" Maximum="25" Value="8" Width="85"
                            VerticalAlignment="Center" Margin="0,0,14,0"
                            ValueChanged="FpsSlider_Changed"/>

                    <!-- Mouse / Keyboard Remote Control Toggle -->
                    <ToggleButton x:Name="BtnMouseControl" Content="🖱 Remote Control" Height="28" Margin="0,0,8,0"
                                  Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                                  Padding="10,4" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold"
                                  Checked="BtnMouseControl_Checked" Unchecked="BtnMouseControl_Unchecked"/>

                    <!-- Pause Button -->
                    <Button Content="⏸ Pause" x:Name="PauseBtn" Click="Pause_Click" Height="28"
                            Background="#FFFFFF" Foreground="#0F172A"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="12,4" Cursor="Hand" FontSize="11.5" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Screen view viewport -->
        <Border Grid.Row="1" Background="#0B0F19" Margin="8" CornerRadius="6" ClipToBounds="True">
            <Image x:Name="ScreenView"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="LowQuality"
                   Focusable="True"
                   MouseMove="ScreenView_MouseMove"
                   MouseDown="ScreenView_MouseDown"
                   MouseUp="ScreenView_MouseUp"
                   KeyDown="ScreenView_KeyDown"
                   KeyUp="ScreenView_KeyUp"/>
        </Border>

        <!-- Status footer -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusLabel" Foreground="#64748B" FontSize="11.5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ControlNotice" Foreground="#2563EB" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" Text="Viewing stream"/>
                <TextBlock x:Name="FpsActual" DockPanel.Dock="Right" Foreground="#64748B"
                           FontSize="11.5" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
