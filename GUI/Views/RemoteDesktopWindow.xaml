<Window x:Class="RWORM.GUI.Views.RemoteDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="1060"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        Title="Remote Desktop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Monitor Selector -->
                    <TextBlock Text="Display:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="MonitorSelector" Width="140" Height="28" Margin="0,0,14,0"
                              SelectionChanged="MonitorSelector_SelectionChanged"
                              VerticalContentAlignment="Center" FontSize="11.5"/>

                    <TextBlock Text="FPS:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="FpsLabel" Text="5" Foreground="#0F172A" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Width="24" Margin="0,0,12,0"/>
                    <Slider x:Name="FpsSlider" Minimum="1" Maximum="20" Value="5" Width="90"
                            VerticalAlignment="Center" Margin="0,0,14,0"
                            ValueChanged="FpsSlider_Changed"/>
                    <Button Content="⏸ Pause" x:Name="PauseBtn" Click="Pause_Click"
                            Background="#FFFFFF" Foreground="#0F172A"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="12,5" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Screen view -->
        <Border Grid.Row="1" Background="#0F172A" Margin="8" CornerRadius="6" ClipToBounds="True">
            <Image x:Name="ScreenView"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="LowQuality"/>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusLabel" Foreground="#64748B" FontSize="11.5"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FpsActual" DockPanel.Dock="Right" Foreground="#64748B"
                           FontSize="11.5" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
