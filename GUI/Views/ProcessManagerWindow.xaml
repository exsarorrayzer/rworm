<Window x:Class="RWORM.GUI.Views.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="860"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#E6EDF3"
        Title="Process Manager">

    <Window.Resources>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background"     Value="#21262D"/>
            <Setter Property="Foreground"     Value="#E6EDF3"/>
            <Setter Property="BorderBrush"    Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="12,6"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid" x:Key="DG">
            <Setter Property="Background"              Value="#0D1117"/>
            <Setter Property="Foreground"              Value="#E6EDF3"/>
            <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#21262D"/>
            <Setter Property="RowBackground"           Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#12161B"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="HeadersVisibility"       Value="Column"/>
            <Setter Property="SelectionMode"           Value="Single"/>
            <Setter Property="SelectionUnit"           Value="FullRow"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" Content="⟳  Refresh"
                        Style="{StaticResource Btn}" Click="Refresh_Click"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="KillBtn" DockPanel.Dock="Right" Content="✕  Kill"
                        Style="{StaticResource Btn}" Click="Kill_Click"
                        IsEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"
                        Foreground="#F85149"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right"
                         Background="#21262D" Foreground="#E6EDF3"
                         BorderBrush="#30363D" BorderThickness="1"
                         Padding="8,5" VerticalAlignment="Center"
                         Width="160" Margin="0,0,8,0"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Process list -->
        <DataGrid x:Name="ProcGrid"
                  Grid.Row="1"
                  Style="{StaticResource DG}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionChanged="ProcGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID"   Binding="{Binding Pid}"   Width="70"/>
                <DataGridTextColumn Header="Name"  Binding="{Binding Name}"  Width="*"/>
                <DataGridTextColumn Header="Mem (KB)" Binding="{Binding Mem}" Width="90"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Margin="16,0"
                       Foreground="#8B949E" FontSize="11"
                       VerticalAlignment="Center" Text="Loading..."/>
        </Border>
    </Grid>
</Window>
