<Window x:Class="RWORM.GUI.Views.ProcessManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="860"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" Foreground="#0F172A"
        Title="Process Manager">

    <Window.Resources>
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background"     Value="#FFFFFF"/>
            <Setter Property="Foreground"     Value="#0F172A"/>
            <Setter Property="BorderBrush"    Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="12,6"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader" x:Key="HeaderStyle">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <Style TargetType="DataGridCell" x:Key="CellStyle">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="TitleLabel" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                <Button DockPanel.Dock="Right" Content="⟳  Refresh"
                        Style="{StaticResource Btn}" Click="Refresh_Click"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="KillBtn" DockPanel.Dock="Right" Content="✕  Kill"
                        Style="{StaticResource Btn}" Click="Kill_Click"
                        IsEnabled="False" VerticalAlignment="Center" Margin="0,0,8,0"
                        Foreground="#EF4444"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right"
                         Background="#FFFFFF" Foreground="#0F172A"
                         CaretBrush="#0F172A"
                         BorderBrush="#CBD5E1" BorderThickness="1"
                         Padding="8,0" VerticalAlignment="Center"
                         Width="180" Height="30" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" VerticalScrollBarVisibility="Disabled"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Process list -->
        <DataGrid x:Name="ProcGrid"
                  Grid.Row="1"
                  Background="#FFFFFF"
                  Foreground="#0F172A"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#F8FAFC"
                  BorderThickness="0"
                  FontSize="12.5"
                  FontFamily="Segoe UI"
                  HeadersVisibility="Column"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  CellStyle="{StaticResource CellStyle}"
                  SelectionChanged="ProcGrid_SelectionChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2563EB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID"   Binding="{Binding Pid}"   Width="80"/>
                <DataGridTextColumn Header="Name"  Binding="{Binding Name}"  Width="*"/>
                <DataGridTextColumn Header="Mem (KB)" Binding="{Binding Mem}" Width="100"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="240"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLabel" Margin="16,0"
                       Foreground="#64748B" FontSize="11.5"
                       VerticalAlignment="Center" Text="Loading..."/>
        </Border>
    </Grid>
</Window>
