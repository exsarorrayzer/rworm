<Application x:Class="RWORM.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RWORM.GUI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Value Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:UrlToImageConverter          x:Key="UrlToImage"/>
            <conv:InverseBoolConverter         x:Key="InverseBoolConverter"/>
            <conv:StringToVisibilityConverter  x:Key="StringToVisibilityConverter"/>
            <conv:StringToBoolConverter        x:Key="StringToBoolConverter"/>

            <!-- Fires on every window (including code-created dialogs) so the
                 Win32 caption is rendered dark instead of the default white. -->
            <Style TargetType="Window">
                <EventSetter Event="Loaded" Handler="OnWindowLoaded"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
