<Window x:Class="RWORM.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RWORM.GUI.Converters"
        Title="RWORM"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundSecondaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:UrlToImageConverter          x:Key="UrlToImage"/>
        <conv:InverseBoolConverter         x:Key="InverseBoolConverter"/>
        <conv:StringToVisibilityConverter  x:Key="StringToVisibilityConverter"/>
        <conv:StringToBoolConverter        x:Key="StringToBoolConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource BackgroundMainBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="20,20,20,30">
                    <Image Source="pack://application:,,,/Resources/Assets/rworm2.png" Width="120" HorizontalAlignment="Left" Margin="20,20,20,20"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Clients"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Clients}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Clients">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/clients.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Listener"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Listener}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Listener" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/listener.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Builder"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Builder}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Builder" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Tasks"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Tasks}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Tasks" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/tasks.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Credits"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Credits}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Credits" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="12,0,12,20">
                    <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource TextPrimaryBrush}"
                                         FontFamily="Cascadia Code, Consolas, Segoe UI"
                                         FontWeight="SemiBold"
                                         Width="140" Height="32" FontSize="12" Padding="8,4"
                                         ToolTip="C2 Server Host / IP"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource TextPrimaryBrush}"
                                         FontFamily="Cascadia Code, Consolas, Segoe UI"
                                         FontWeight="SemiBold"
                                         Width="64" Height="32" FontSize="12" Padding="8,4" Margin="6,0,0,0"
                                         ToolTip="C2 Server Port"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                                        Command="{Binding ConnectCommand}" Height="28" Padding="12,0"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                <Button Style="{StaticResource DangerButton}" Content="Disconnect"
                                        Command="{Binding DisconnectCommand}" Height="28" Padding="12,0"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Grid.Row="0" Margin="24">
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Clients}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Clients" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshClientsCommand}"
                            HorizontalAlignment="Right" Height="36" Padding="14,0" MinWidth="110"
                            Cursor="Hand" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <Grid x:Name="ClientsGridContainer" ClipToBounds="True">
                        <DataGrid x:Name="ClientsGrid"
                                  ItemsSource="{Binding Clients}"
                                  SelectedItem="{Binding SelectedClient}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  SelectionChanged="ClientsGrid_SelectionChanged"
                                  PreviewMouseLeftButtonDown="ClientsGrid_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="ClientsGrid_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="ClientsGrid_PreviewMouseLeftButtonUp"
                                  PreviewMouseRightButtonDown="ClientsGrid_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="ClientsGrid_ContextMenuOpening"
                                  LostMouseCapture="ClientsGrid_LostMouseCapture">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="ClientsContextMenu" Opened="ClientsContextMenu_Opened">
                                <MenuItem Command="{Binding OpenShellCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/shell.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Shell" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenFileManagerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/filemanager.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="File Manager" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenKeyloggerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/keylogger.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Keylogger" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenProcManagerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/processmanager.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Process Manager" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenRegistryEditorCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/registryeditor.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Registry Editor" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenRemoteDesktopCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/remotedesktop.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Remote Desktop" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenServiceManagerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/services.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Service Manager" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenNetMonitorCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/network.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Network Connections" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenAutorunManagerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/startup.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Startup / Autorun" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenClipboardManagerCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/clipboard.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Clipboard Manager" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenWebcamCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/webcam.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Webcam" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenAudioCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/audio.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Audio Monitor" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenUrlCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/url.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open URL..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenInstalledProgramsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/programs.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Installed Programs" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Command="{Binding OpenReverseProxyCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/proxy.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Reverse Proxy" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenMessageBoxCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/msgbox.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Message Box..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Header="Client Chat">
                                    <MenuItem.Icon>
                                        <Image Source="pack://application:,,,/Resources/Assets/chat.png" Width="15" Height="15"/>
                                    </MenuItem.Icon>
                                    <MenuItem Header="Open Chat (v1)"
                                              Command="{Binding OpenClientChatCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/Resources/Assets/chat.png" Width="15" Height="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="PC">
                                    <MenuItem.Icon>
                                        <Image Source="pack://application:,,,/Resources/Assets/pc.png" Width="15" Height="15"/>
                                    </MenuItem.Icon>
                                    <MenuItem Header="System Information"
                                              Command="{Binding OpenSystemInfoCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        <MenuItem.Icon>
                                            <Image Source="pack://application:,,,/Resources/Assets/sysinfo.png" Width="15" Height="15"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Lock Workstation"
                                              Command="{Binding PowerLockCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Sleep"
                                              Command="{Binding PowerSleepCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Hibernate"
                                              Command="{Binding PowerHibernateCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Restart"
                                              Command="{Binding PowerRestartCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Shutdown"
                                              Command="{Binding PowerShutdownCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Log Off"
                                              Command="{Binding PowerLogoffCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Loader">
                                    <MenuItem.Icon>
                                        <Image Source="pack://application:,,,/Resources/Assets/loader.png" Width="15" Height="15"/>
                                    </MenuItem.Icon>
                                    <MenuItem Header="Execute from URL..."
                                              Command="{Binding LoaderExecCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Execute from Local File..."
                                              Command="{Binding LoaderExecFileCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Command="{Binding ClientCloseCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/close.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Close Client" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ClientUninstallCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/uninstall.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Uninstall" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding ClientUpdateCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/update.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Update Client" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Country" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="4,0">
                                            <Image Source="{Binding FlagImagePath,
                                                           Converter={StaticResource UrlToImage}}"
                                                   Width="24" Height="18"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding CountryCode}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Hostname"   Binding="{Binding Hostname}"   Width="*"/>
                            <DataGridTextColumn Header="Username"   Binding="{Binding Username}"   Width="100"/>
                            <DataGridTemplateColumn Header="IP Address" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IpAddress}"
                                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="OS"         Binding="{Binding OSVersion}"  Width="140"/>
                            <DataGridTextColumn Header="Load"       Binding="{Binding MetricsDisplay}" Width="125"/>
                            <DataGridTextColumn Header="Last Seen"  Binding="{Binding LastSeen, StringFormat='{}{0:HH:mm:ss}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionBox"
                                   Fill="#330078D7"
                                   Stroke="#0078D7"
                                   StrokeThickness="1"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Border>
            </Grid>
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Listener}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Listener" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host / IP:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ListenerHost, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Cascadia Code, Consolas, Segoe UI"
                                     FontWeight="SemiBold"
                                     FontSize="13" Height="38"
                                     Margin="0,0,0,12"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ListenerPort, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Cascadia Code, Consolas, Segoe UI"
                                     FontWeight="SemiBold"
                                     FontSize="13" Height="38"
                                     Margin="0,0,0,12"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Start"
                                        Command="{Binding StartListenerCommand}" Height="36" Padding="24,0"/>
                                <Button Style="{StaticResource DangerButton}" Content="Stop"
                                        Command="{Binding StopListenerCommand}" Height="36" Padding="24,0" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Listener Status" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ListenerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ListenerStatus, FallbackValue='Stopped'}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontFamily="Cascadia Code, Consolas, Segoe UI"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Builder}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Client Builder" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="28" RenderTransformOrigin="0.5,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BuilderCardScale" ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform x:Name="BuilderCardTranslate" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BuilderCardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     From="0.25" To="1.0" Duration="0:0:0.7">
                                        <DoubleAnimation.EasingFunction>
                                            <ElasticEase Oscillations="2" Springiness="4" EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="BuilderCardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     From="1.25" To="1.0" Duration="0:0:0.7">
                                        <DoubleAnimation.EasingFunction>
                                            <ElasticEase Oscillations="2" Springiness="4" EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="BuilderCardTranslate"
                                                     Storyboard.TargetProperty="Y"
                                                     From="-40" To="0" Duration="0:0:0.6">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <Border Background="{StaticResource BackgroundSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Active Configuration Preview:" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2">
                                    <Run Text="• C2 Target: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BuildHost}"/>
                                    <Run Text=":"/>
                                    <Run Text="{Binding BuildPort}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2">
                                    <Run Text="• Keylogger: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding BuildKeyloggerEnabled, StringFormat='Enabled: {0}'}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2">
                                    <Run Text="• Binary Size: " FontWeight="SemiBold"/>
                                    <Run Text="Self-Contained &amp; Trimmed (~11 MB)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenBuilderCommand}"
                                Height="46" Padding="24,0" HorizontalAlignment="Left"
                                FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Resources/Assets/builder.png"
                                       Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Builder Window" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Tasks}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Tasks" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Background="Transparent"
                        PreviewMouseRightButtonDown="TasksBorder_PreviewMouseRightButtonDown">
                    <Border.ContextMenu>
                        <ContextMenu x:Name="TasksContextMenu">
                            <MenuItem Command="{Binding AddDiscordWebhookTaskCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/discord.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Discord Webhook" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding AddLocalFileTaskCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/filemanager.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Run File Local" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding AddUrlTaskCommand}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/loader.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Run File from URL" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Command="{Binding RemoveTaskCommand}"
                                      CommandParameter="{Binding SelectedTask}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/close.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Remove Task" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DataGrid x:Name="TasksGrid"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              Background="Transparent"
                              PreviewMouseRightButtonDown="TasksGrid_PreviewMouseRightButtonDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconPath}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name"       Binding="{Binding Name}"          Width="180"/>
                            <DataGridTextColumn Header="Type"       Binding="{Binding ModeLabel}"     Width="130"/>
                            <DataGridTextColumn Header="Executions" Binding="{Binding ExecutedCount}" Width="90"/>
                            <DataGridTextColumn Header="Source"     Binding="{Binding Source}"        Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Padding="8,0"
                                                   VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running…">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Image Source="pack://application:,,,/Resources/Assets/tasks.png" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.4"/>
                                                        <TextBlock Text="No tasks yet" FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Right-click to add a task (Discord Webhook, Run File Local, Run File from URL)"
                                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>
                </Border>
            </Grid>
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Credits}">
                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Assets/rworm2.png" Width="100" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="RWORM" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Remote Access Tool" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
                        <TextBlock Text="Developer" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rayzer" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                        <TextBlock Text="GitHub" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="github.com/exsarorrayzer" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource BackgroundMainBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClientCount, StringFormat='Clients: {0}'}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>