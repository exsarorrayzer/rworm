<Window x:Class="RWORM.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RWORM.GUI.Converters"
        Title="RWORM"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundSecondaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:UrlToImageConverter          x:Key="UrlToImage"/>
        <conv:InverseBoolConverter         x:Key="InverseBoolConverter"/>
        <conv:StringToVisibilityConverter  x:Key="StringToVisibilityConverter"/>
        <conv:StringToBoolConverter        x:Key="StringToBoolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,20,20,30">
                    <Image Source="pack://application:,,,/Resources/Assets/rworm.png" Width="120" HorizontalAlignment="Left" Margin="20,20,20,20"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Clients"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Clients}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Clients">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/clients.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Listener"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Listener}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Listener" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/listener.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Builder"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Builder}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Builder" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/builder.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <!-- Tasks -->
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Tasks"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Tasks}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Tasks" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                    <RadioButton Style="{StaticResource SidebarButton}" Content="Credits"
                                 IsChecked="{Binding SelectedView, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Credits}"
                                 GroupName="Nav" Command="{Binding NavigateCommand}" CommandParameter="Credits" Margin="0,4,0,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="pack://application:,,,/Resources/Assets/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Row="2" Margin="12,0,12,20">
                    <Border Background="{StaticResource BackgroundTertiaryBrush}" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Width="90" Height="28" FontSize="11" Padding="8,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                         Width="50" Height="28" FontSize="11" Padding="8,6" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                                        Command="{Binding ConnectCommand}" Height="28" Padding="12,0"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                <Button Style="{StaticResource DangerButton}" Content="Disconnect"
                                        Command="{Binding DisconnectCommand}" Height="28" Padding="12,0"
                                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="24">
            

            <!-- Clients View -->
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Clients}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Clients" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Refresh"
                            Command="{Binding RefreshClientsCommand}"
                            HorizontalAlignment="Right" Height="34"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <DataGrid x:Name="ClientsGrid"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Extended"
                              SelectionChanged="ClientsGrid_SelectionChanged">

                        <!-- ── Right-click context menu ─────────────────────── -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <!-- Shell -->
                                <MenuItem Command="{Binding PlacementTarget.DataContext.OpenShellCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Assets/shell.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Shell" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <!-- File Manager -->
                                <MenuItem Header="📁  File Manager"
                                          Command="{Binding PlacementTarget.DataContext.OpenFileManagerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Keylogger -->
                                <MenuItem Header="⌨️  Keylogger"
                                          Command="{Binding PlacementTarget.DataContext.OpenKeyloggerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Process Manager -->
                                <MenuItem Header="⚙️  Process Manager"
                                          Command="{Binding PlacementTarget.DataContext.OpenProcManagerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Registry Editor -->
                                <MenuItem Header="🗝️  Registry Editor"
                                          Command="{Binding PlacementTarget.DataContext.OpenRegistryEditorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Remote Desktop -->
                                <MenuItem Header="🖥️  Remote Desktop"
                                          Command="{Binding PlacementTarget.DataContext.OpenRemoteDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Loader -->
                                <MenuItem Header="🚀  Loader (Execute URL)"
                                          Command="{Binding PlacementTarget.DataContext.LoaderExecCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <!-- Close -->
                                <MenuItem Header="⏹  Close Client"
                                          Command="{Binding PlacementTarget.DataContext.ClientCloseCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Uninstall -->
                                <MenuItem Header="🗑  Uninstall"
                                          Command="{Binding PlacementTarget.DataContext.ClientUninstallCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <!-- Update -->
                                <MenuItem Header="🔄  Update Client"
                                          Command="{Binding PlacementTarget.DataContext.ClientUpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- Status dot -->
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Country flag (local PNG rendered from bundled SVGs + code) -->
                            <DataGridTemplateColumn Header="Country" Width="96">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="4,0">
                                            <!-- Local flag PNG from Resources/Flags -->
                                            <Image Source="{Binding FlagImagePath,
                                                           Converter={StaticResource UrlToImage}}"
                                                   Width="24" Height="18"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <!-- Country code fallback text -->
                                            <TextBlock Text="{Binding CountryCode}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Hostname"   Binding="{Binding Hostname}"   Width="*"/>
                            <DataGridTextColumn Header="Username"   Binding="{Binding Username}"   Width="100"/>
                            <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}"  Width="120"/>
                            <DataGridTextColumn Header="OS"         Binding="{Binding OSVersion}"  Width="150"/>
                            <DataGridTextColumn Header="Last Seen"  Binding="{Binding LastSeen, StringFormat='{}{0:HH:mm:ss}'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

            </Grid>

            <!-- Listener View -->
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Listener}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Listener" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ListenerHost, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ListenerPort, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Start"
                                        Command="{Binding StartListenerCommand}" Height="36" Padding="24,0"/>
                                <Button Style="{StaticResource DangerButton}" Content="Stop"
                                        Command="{Binding StopListenerCommand}" Height="36" Padding="24,0" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Listener Status" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ListenerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ListenerStatus, FallbackValue='Stopped'}"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Builder View -->
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Builder}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Builder" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <!-- C2 config -->
                        <TextBlock Text="C2 Host" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding BuildHost, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="C2 Port" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding BuildPort, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,24"/>

                        <!-- Keylogger options -->
                        <TextBlock Text="Keylogger" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <CheckBox Content="Enable Keylogger"
                                  IsChecked="{Binding BuildKeyloggerEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24"
                                    IsEnabled="{Binding BuildKeyloggerEnabled}">
                            <RadioButton Content="Offline (log to file until retrieved)"
                                         IsChecked="{Binding BuildKeyloggerOnline, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                            <RadioButton Content="Online (stream live)"
                                         IsChecked="{Binding BuildKeyloggerOnline}"
                                         Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Task on connect -->
                        <TextBlock Text="Task on Connect" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <CheckBox Content="Enable Loader Task on Connect"
                                  IsChecked="{Binding BuildTaskEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Text="Payload URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"
                                   IsEnabled="{Binding BuildTaskEnabled}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding BuildTaskUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,24"
                                 IsEnabled="{Binding BuildTaskEnabled}"/>

                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Build Client" Command="{Binding BuildCommand}"
                                Height="44" Padding="32,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tasks View -->
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Tasks}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Tasks" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📁  Add Local File" Command="{Binding AddLocalFileTaskCommand}"
                                Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="🔗  Add URL Task"   Command="{Binding AddUrlTaskCommand}"
                                Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="▶  Run on Selected" Command="{Binding RunTaskOnSelectedCommand}"
                                Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="🗑  Remove"          Command="{Binding RemoveTaskCommand}"
                                Style="{StaticResource DangerButton}" Height="36" Padding="16,0"/>
                    </StackPanel>
                </Grid>

                <!-- Task list -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                    <DataGrid ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📁  Add Local File Task"
                                          Command="{Binding PlacementTarget.DataContext.AddLocalFileTaskCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="🔗  Add URL Task"
                                          Command="{Binding PlacementTarget.DataContext.AddUrlTaskCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="▶  Run on Selected Clients"
                                          Command="{Binding PlacementTarget.DataContext.RunTaskOnSelectedCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <Separator/>
                                <MenuItem Header="🗑  Remove Task"
                                          Command="{Binding PlacementTarget.DataContext.RemoveTaskCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"      Width="200"/>
                            <DataGridTextColumn Header="Type"   Binding="{Binding ModeLabel}"  Width="130"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}"     Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Padding="8,0"
                                                   VerticalAlignment="Center" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running…">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- Empty state -->
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                        <TextBlock Text="No tasks yet" FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Right-click or use the buttons above to add a task"
                                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Credits View -->
            <Grid Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Credits}">
                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Assets/rworm.png" Width="100" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="RWORM" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Remote Access Tool" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,24"/>

                        <TextBlock Text="Developer" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rayzer" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,16"/>

                        <TextBlock Text="GitHub" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="github.com/exsarorrayzer" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Column="1" Grid.Row="1" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Multi-select send button -->
                    <Button Content="📢 Send to Selected"
                            Command="{Binding SendToAllCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="28" Padding="12,0" Margin="0,0,16,0"
                            FontSize="11"
                            Visibility="{Binding SelectedView, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Clients}"/>

                    <TextBlock Text="{Binding ClientCount, StringFormat='Clients: {0}'}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>